POSTGRES_DB=newsproof
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/newsproof
COHERE_API_KEY=
GOOGLE_PROGRAMMABLE_SEARCH_API_KEY=
GOOGLE_PROGRAMMABLE_SEARCH_ENGINE_ID=
BRAVE_SEARCH_API_KEY=
ENABLE_CLAIM_VERIFIER_MODEL=false
CLAIM_VERIFIER_MODEL_PATH=/app/ml/models/claim-evidence-verifier
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://backend:8000
BACKEND_CORS_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000
BACKEND_CORS_ORIGIN_REGEX=^https://[a-zA-Z0-9-]+\.(ngrok-free\.app|ngrok\.io)$
UPLOAD_DIR=/app/uploads
IMAGE_UPLOAD_MAX_BYTES=5000000
AUDIO_UPLOAD_MAX_BYTES=25000000
VIDEO_UPLOAD_MAX_BYTES=100000000
APP_ENV=development
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
PLATFORM_SIGNING_PRIVATE_KEY_B64=
PLATFORM_ISSUER_NAME=NewsProof Platform
TIMESTAMP_MODE=internal
TSA_URL=
